#include "bme280.h"
#include "i2c1_bare_metal.h"

/* =========================================================================
 * BME280 register map (see Bosch BME280 datasheet, section 5.3)
 * ========================================================================= */
#define BME280_REG_CHIP_ID       0xD0U /* Should always read back 0x60        */
#define BME280_REG_RESET         0xE0U /* Write 0xB6 to soft-reset the sensor */
#define BME280_REG_CTRL_HUM      0xF2U /* Humidity oversampling setting       */
#define BME280_REG_STATUS        0xF3U /* Measuring/updating status bits      */
#define BME280_REG_CTRL_MEAS     0xF4U /* Temp/press oversampling + power mode*/
#define BME280_REG_CONFIG        0xF5U /* Standby time, IIR filter, SPI mode  */
#define BME280_REG_PRESS_MSB     0xF7U /* First of 8 contiguous data regs:    */
                                        /* press(3) + temp(3) + hum(2) = 8 bytes */

#define BME280_REG_CALIB00       0x88U /* dig_T1..dig_P9, 26 bytes            */
#define BME280_REG_CALIB26       0xE1U /* dig_H2..dig_H6, 7 bytes             */
#define BME280_REG_DIG_H1        0xA1U /* dig_H1, 1 byte (separate from block)*/

#define BME280_CHIP_ID_VALUE     0x60U
